{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "_comment": "OpenTelemetry export is opt-in PER MACHINE, deliberately not set here. This file previously enabled CLAUDE_CODE_ENABLE_TELEMETRY for every contributor with OTEL_EXPORTER_OTLP_PROTOCOL=grpc and no endpoint, which defaults to localhost:4317 -- the same port Aspire's dashboard binds in this repo, so every contributor without their own collector there either silently failed to export or collided with Aspire. To opt in on your own machine, add these keys under an env block in .claude/settings.local.json (gitignored, per-machine, merged over this file): CLAUDE_CODE_ENABLE_TELEMETRY=1, CLAUDE_CODE_ENHANCED_TELEMETRY_BETA=1, OTEL_METRICS_EXPORTER=otlp, OTEL_LOGS_EXPORTER=otlp, OTEL_TRACES_EXPORTER=otlp, OTEL_EXPORTER_OTLP_PROTOCOL=grpc, OTEL_METRIC_EXPORT_INTERVAL=10000, OTEL_RESOURCE_ATTRIBUTES=service.name=claude-squad,deployment.environment=local, plus your own OTEL_EXPORTER_OTLP_ENDPOINT. The squad's app and the squad's agent should share the same OTLP endpoint and slice by service.name."
  },
  "statusLine": {
    "type": "command",
    "command": "python3 $CLAUDE_PROJECT_DIR/.claude/statusline.py",
    "refreshInterval": 10
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/session-context-loader.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/skill-router.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-conventional-commits.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-gpg-signing.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-no-secrets.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-large-files.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/dotnet-format-on-save.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/precompact-snapshot.py",
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/scribe-decision-merger.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-logger.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/squad-rotate.py",
            "async": true
          }
        ]
      }
    ]
  }
}
